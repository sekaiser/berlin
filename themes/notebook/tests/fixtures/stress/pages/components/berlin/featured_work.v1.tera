{% import "macros/notebook_entry_layout.tera" as entry_layout %}
{% set preview_side = entry_layout::preview_side(target=props.source.url | replace(from=config_site_url,to="")) | trim %}
{% set featured = site.page_path == "/" and (props.source.url is ending_with("/notes/long-title.html") or props.source.url is ending_with("/notes/illustrated-entry.html")) %}
<article class="publication-work journal-entry{% if featured %} journal-entry--featured{% endif %}{% if preview_side == 'right' %} journal-entry--preview-right{% endif %}" id="{{ view.anchor }}">
  {% if props.source.preview and preview_side != "right" %}<a class="journal-entry-visual" href="{{ props.source.url }}"><img src="{{ props.source.preview.url }}" alt="{{ props.source.preview.alt }}" loading="lazy"></a>{% endif %}
  <div class="journal-entry-copy">
  {% if featured %}<p class="journal-entry-label">Selected note</p>{% endif %}
  <h{{ view.heading_level }}><a href="{{ props.source.url }}">{{ props.source.title }}</a></h{{ view.heading_level }}>
  {% if props.source.published %}<p class="journal-date"><span>Published</span><time datetime="{{ props.source.published }}">{{ props.source.published }}</time></p>{% endif %}
  {% if props.source.tags %}<ul class="publication-tags" aria-label="Tags">{% for tag in props.source.tags %}<li><span class="paper-tag" data-tag="{{tag | lower}}" data-tag-color="{{ tag | lower | stable_hash % 64 }}"><span>{{tag}}</span></span></li>{% endfor %}</ul>{% endif %}
  <div class="journal-excerpt">{{ render_slot(owner=view.id, name="source_description") }}</div>
  {% if props.source.origin == "external" and props.source.description %}<p>{{ props.source.description }}</p>{% endif %}
  {% if props.annotation %}<div class="publication-annotation">{% for paragraph in props.annotation_paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</div>{% endif %}
  </div>
  {% if props.source.preview and preview_side == "right" %}<a class="journal-entry-visual" href="{{ props.source.url }}"><img src="{{ props.source.preview.url }}" alt="{{ props.source.preview.alt }}" loading="lazy"></a>{% endif %}
</article>
