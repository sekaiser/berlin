<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ publication.title }}</title>
  {% if publication.description %}<meta name="description" content="{{ publication.description }}">{% endif %}
  {% for stylesheet in site.stylesheets %}<link rel="stylesheet" href="{{ stylesheet }}">{% endfor %}
</head>
<body class="publication-page">
  <main>{{ render_slot(owner=view.id, name="body") }}</main>
</body>
</html>
