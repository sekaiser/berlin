{% extends "_overview.tera" %}
{% import "macros/notebook_entry.tera" as notes %}

{% block overview_kind %}notebook-index{% endblock overview_kind %}
{% block overview_opening %}
    <p class="journal-label">The notebook</p>
    <h1>Thinking <em>in writing.</em></h1>
    <p class="journal-lead">Notes on software, systems, and things I’m trying to understand.</p>
{% endblock overview_opening %}
{% block overview_body %}
  {% include "partials/guides.tera" %}
  <div class="journal-index-entries">
    {% for a in articles %}
      {{ notes::entry(title=a.title, description=a.description, date=a.date, target=a.target, topics=a.tags, heading_level=2, kind=a.kind, preview=a.preview) }}
    {% else %}
      <p class="journal-empty">The first notes are taking shape.</p>
    {% endfor %}
  </div>
  <a class="journal-link journal-more" href="{{config_site_url}}/">Back to the notebook’s entrance</a>
{% endblock overview_body %}
