{# Use authored raster artwork for sharing. SVG remains available in site cards. #}
{% set preview_media_type = "" %}
{% if page_preview %}
  {% set preview_path = page_preview.url | split(pat="?") | first | split(pat="#") | first | lower %}
  {% if preview_path is ending_with(".png") %}
    {% set preview_media_type = "image/png" %}
  {% elif preview_path is ending_with(".jpg") or preview_path is ending_with(".jpeg") %}
    {% set preview_media_type = "image/jpeg" %}
  {% elif preview_path is ending_with(".webp") %}
    {% set preview_media_type = "image/webp" %}
  {% elif preview_path is ending_with(".gif") %}
    {% set preview_media_type = "image/gif" %}
  {% endif %}
  {% if preview_media_type %}
    {% set sharing_image = page_preview.url %}
    {% set sharing_image_type = preview_media_type %}
    {% set sharing_image_width = page_preview.width %}
    {% set sharing_image_height = page_preview.height %}
    {% set sharing_image_alt = page_preview.alt %}
  {% endif %}
{% endif %}
{% if sharing_image %}
  <meta property="og:image" content="{{sharing_image}}">
  <meta property="og:image:type" content="{{sharing_image_type}}">
  <meta property="og:image:width" content="{{sharing_image_width}}">
  <meta property="og:image:height" content="{{sharing_image_height}}">
  <meta property="og:image:alt" content="{{sharing_image_alt}}">
  <meta name="twitter:card" content="{% if sharing_image_width > sharing_image_height %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:image" content="{{sharing_image}}">
  <meta name="twitter:image:alt" content="{{sharing_image_alt}}">
{% else %}
  <meta name="twitter:card" content="summary">
{% endif %}
