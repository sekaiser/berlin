<section class="article-backlinks" aria-labelledby="backlinks-title">
  <h2 id="backlinks-title">Referenced in</h2>
  <ul class="backlink-sources">
    {% for source_id, passages in page_backlinks | group_by(attribute="source_id") %}
    {% set reference = passages | first %}
    {% set passage_count = passages | length %}
    <li class="backlink-source">
      <a class="backlink-title" href="{{config_site_url}}{{reference.path}}">{{reference.title}}</a>
      {% if reference.excerpt %}<blockquote>{{reference.excerpt}}</blockquote>{% endif %}
      {% if passage_count > 1 %}
      <details class="backlink-more">
        <summary>{{ passage_count - 1 }} more {% if passage_count == 2 %}passage{% else %}passages{% endif %}</summary>
        <ul class="backlink-passages">
          {% for passage in passages | slice(start=1) %}
          <li>
            <a href="{{config_site_url}}{{passage.path}}">Passage {{loop.index + 1}}<span class="backlink-context"> in {{reference.title}}</span></a>
            {% if passage.excerpt %}<blockquote>{{passage.excerpt}}</blockquote>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
