<article class="publication-excerpt" id="{{ view.anchor }}">
  {% if props.annotation %}<div class="publication-annotation">{% for paragraph in props.annotation_paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</div>{% endif %}
  {{ render_slot(owner=view.id, name="excerpt") }}
  <p class="publication-attribution">From <a href="{{ props.source.url }}">{{ props.source.title }}</a></p>
</article>
