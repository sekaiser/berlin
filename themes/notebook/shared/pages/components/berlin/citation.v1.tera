<p class="publication-citation" id="{{ view.anchor }}">{% if props.style != "short" %}{% if props.resource.authors %}{{ props.resource.authors | join(sep=", ") }}. {% endif %}{% endif %}<cite><a href="{{ props.resource.url }}">{{ props.resource.title }}</a></cite>{% if props.style != "short" %}{% if props.resource.publisher %}. {{ props.resource.publisher }}{% endif %}{% if props.resource.published %}. <time datetime="{{ props.resource.published }}">{{ props.resource.published }}</time>{% endif %}{% endif %}{% if props.annotation %}. {{ props.annotation }}{% endif %}</p>
