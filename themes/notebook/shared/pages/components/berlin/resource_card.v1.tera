<article class="publication-resource publication-resource--{{ props.resource.kind_class }}{% if props.presentation == "compact" %} publication-resource--compact{% endif %}" id="{{ view.anchor }}">
  {% if props.resource.preview %}<img class="publication-resource-preview" src="{{ props.resource.preview.url }}" alt="{{ props.resource.preview.alt }}" loading="lazy">{% endif %}
  <p class="publication-resource-kind">{{ props.resource.kind_label }}</p>
  <h{{ view.heading_level }}><a href="{{ props.resource.url }}">{{ props.resource.title }}</a></h{{ view.heading_level }}>
  {% if props.resource.authors %}<p class="publication-resource-meta">{{ props.resource.authors | join(sep=", ") }}</p>{% endif %}
  {% if props.resource.published %}<time datetime="{{ props.resource.published }}">{{ props.resource.published }}</time>{% endif %}
  {% if props.resource.description %}<p>{{ props.resource.description }}</p>{% endif %}
  {% if props.resource.tags %}<ul class="publication-tags" aria-label="Tags">{% for tag in props.resource.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
  {% if props.annotation %}<div class="publication-annotation">{% for paragraph in props.annotation_paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</div>{% endif %}
  {% if slots.body %}{{ render_slot(owner=view.id, name="body") }}{% endif %}
</article>
