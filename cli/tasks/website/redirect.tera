<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Moved: {{title}}</title>
  <meta name="berlin-redirect" content="{{target}}">
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="{{destination}}">
  <script>
    // Keep deep links and query parameters; never take the destination from input.
    (function () {
      const target = new URL(document.querySelector('link[rel="canonical"]').href);
      target.search = location.search;
      target.hash = location.hash;
      location.replace(target.href);
    }());
  </script>
  <meta http-equiv="refresh" content="0;url={{destination}}">
</head>
<body><p>This note has moved. <a href="{{destination}}">Continue to {{title}}</a>.</p></body>
</html>
