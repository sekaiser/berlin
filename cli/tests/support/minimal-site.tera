<!doctype html><html><head><link rel="canonical" href="{{config_site_url}}{{page_path}}"><link rel="stylesheet" href="{{config_site_url}}/static/style.css">{% for stylesheet in site.stylesheets %}<link rel="stylesheet" href="{{stylesheet}}">{% endfor %}</head><body>{{ render_slot(owner=view.id, name="body") }}</body></html>
